<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<link rel="stylesheet" href="styleQuestoes.css">


<div class="filtro">
    <h1>Filtrar Questões</h1>
    
    <form id="filtrarQuestoes">

        <!-- PALAVRA-CHAVE -->
        <div class="my-3">

            <label for="palavra-chave" class="form-label">
                Palavra-chave
            </label>

            <input
                class="form-control"
                type="text"
                id="palavra-chave"
                name="palavra-chave"
                placeholder="Busque por palavra-chave">

        </div>

        <!-- TODOS OS CAMPOS SERÃO CRIADOS AQUI -->
        <div id="containerFiltros"></div>

    </form>

    <p>Questões que</p>

    <div class="btn-group" role="group"
        aria-label="Basic checkbox toggle button group">

        <input type="checkbox" class="btn-check" id="btncheck1"
            autocomplete="off">
        <label class="btn btn-outline-primary" for="btncheck1">Não
            resolvi</label>

        <input type="checkbox" class="btn-check" id="btncheck2"
            autocomplete="off">
        <label class="btn btn-outline-primary" for="btncheck2">Resolvi</label>

        <input type="checkbox" class="btn-check" id="btncheck3"
            autocomplete="off">
        <label class="btn btn-outline-primary" for="btncheck3">Acertei</label>

        <input type="checkbox" class="btn-check" id="btncheck4"
            autocomplete="off">
        <label class="btn btn-outline-primary" for="btncheck4">Errei</label>
    </div>
</div>
<div class="questoes">

    {{#each questoes}}
    <div class="questao card p-3 my-4" data-id-questao="{{id_questao}}">

        <p class="identificacao text-muted">
            {{vestibular}} ({{banca}}) {{ano}}
            {{#if disciplinas}} - {{disciplinas}}{{/if}}
            {{#if conteudos}} - {{conteudos}}{{/if}}
        </p>

        <p class="enunciado">{{enunciado}}</p>

        {{#if tem_imagem}}
        <img src="/questoes/{{id_questao}}/imagem"
            class="img-fluid mb-3"
            loading="lazy"
            alt="Imagem da questão {{id_questao}}">
        {{/if}}

        <div class="alternativas">
            {{#each alternativas}}
            <div class="form-check">
                <input
                    class="form-check-input"
                    type="radio"
                    name="questao-{{../id_questao}}"
                    id="q{{../id_questao}}-{{id_alternativas}}"
                    value="{{id_alternativas}}">

                <label class="form-check-label"
                    for="q{{../id_questao}}-{{id_alternativas}}">
                    <strong>{{letra}})</strong> {{texto}}
                </label>
            </div>
            {{/each}}
        </div>

        <div class="mt-3">
            <button type="button" class="btn btn-primary btn-verificar"
                data-questao="{{id_questao}}">
                Verificar resposta
            </button>
        </div>

        <div class="resultado mt-2"></div>
    </div>
    {{else}}
    <p>Nenhuma questão encontrada.</p>
    {{/each}}

</div>

<script>

// Javascript para verificar questões corretas
document.querySelectorAll(".btn-verificar").forEach(btn => {
    btn.addEventListener("click", async () => {
        const id = btn.dataset.questao;
        const card = btn.closest(".questao");
        const marcada = card.querySelector(`input[name="questao-${id}"]:checked`);
        const resultado = card.querySelector(".resultado");

        resultado.replaceChildren();

        if (!marcada) {
            resultado.textContent = "Selecione uma alternativa.";
            resultado.className = "resultado mt-2 text-warning";
            return;
        }

        const resp = await fetch(`/questoes/${id}/responder`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ id_alternativa: marcada.value })
        });
        const dados = await resp.json();

        // Limpa marcações anteriores e destaca correta/errada
        card.querySelectorAll(".form-check-label")
            .forEach(l => l.classList.remove("text-success", "text-danger", "fw-bold"));

        card.querySelector(`label[for="q${id}-${dados.id_correta}"]`)
            .classList.add("text-success", "fw-bold");

        if (!dados.acertou) {
            card.querySelector(`label[for="${marcada.id}"]`).classList.add("text-danger");
        }

        const msg = document.createElement("strong");
        msg.className = dados.acertou ? "text-success" : "text-danger";
        msg.textContent = dados.acertou ? "Acertou!" : "Errou.";
        resultado.className = "resultado mt-2";
        resultado.append(msg);

        if (dados.explicacao) {
            const p = document.createElement("p");
            p.className = "mt-2 mb-0";
            p.textContent = dados.explicacao;
            resultado.append(p);
        }
    });
});


// LISTAS

const disciplinas = [

    "Biologia",
    "Espanhol",
    "Física",
    "Filosofia",
    "Geografia",
    "História",
    "Inglês",
    "Matemática",
    "Português",
    "Química",
    "Redação",
    "Sociologia"

];


const conteudos = [

    "Álgebra",
    "Geometria",
    "Trigonometria",
    "Funções",
    "Equações",
    "Probabilidade",
    "Estatística"

];


const bancas = [

    "CEBRASPE",
    "FCC",
    "FGV",
    "VUNESP",
    "AOCP"

];


const anos = [

    "2026",
    "2025",
    "2024",
    "2023",
    "2022"

];


// CONFIGURAÇÃO DOS CAMPOS

const filtros = [

    {
        nome: "Disciplina",
        lista: disciplinas,
        multiplo: true
    },

    {
        nome: "Conteúdo",
        lista: conteudos,
        multiplo: true
    },

    {
        nome: "Banca",
        lista: bancas,
        multiplo: true
    },

    {
        nome: "Ano",
        lista: anos,
        multiplo: true
    }

];

// CONTAINER

const container =
    document.getElementById("containerFiltros");

// FUNÇÃO GENÉRICA


function criarCampoFiltro(config) {

    const campo =
        document.createElement("div");

    campo.className =
        "my-3 campo-filtro";


    campo.innerHTML = `

        <label class="form-label">
            ${config.nome}
        </label>


        <div class="dropdown w-100">


            <!-- BOTÃO -->

            <button
                type="button"
                class="form-select text-start botao-filtro"
                data-bs-toggle="dropdown"
                data-bs-auto-close="outside">

                <span class="texto-selecione">
                  Selecione ${config.nome.toLowerCase()}
                </span>

            </button>


            <!-- MENU -->

            <ul class="dropdown-menu w-100 p-2">


                <!-- PESQUISA -->

                <li class="campo-pesquisa">

                    <input
                        type="text"
                        class="form-control pesquisa-filtro"
                        placeholder="Pesquisar..."
                        autocomplete="off">

                </li>


                <li>
                    <hr class="dropdown-divider">
                </li>


                <!-- OPÇÕES -->

                <div class="lista-filtro">

                    ${config.lista.map(opcao => `

                        <li class="item-filtro">

                            <div class="form-check">

                                <input
                                    class="form-check-input checkbox-filtro"
                                    type="checkbox"
                                    value="${opcao}">

                                <label class="form-check-label">
                                    ${opcao}
                                </label>

                            </div>

                        </li>

                    `).join("")}

                </div>

            </ul>

        </div>

    `;


    container.appendChild(campo);

    // ELEMENTOS

    const botao =
        campo.querySelector(".botao-filtro");

    const pesquisa =
        campo.querySelector(".pesquisa-filtro");

    const itens =
        campo.querySelectorAll(".item-filtro");

    const checkboxes =
        campo.querySelectorAll(".checkbox-filtro");

    // PESQUISA


    pesquisa.addEventListener("input", function () {

        const texto =
            this.value
                .toLowerCase()
                .trim();


        itens.forEach(function (item) {

            const nome =
                item
                    .querySelector(".form-check-label")
                    .textContent
                    .toLowerCase();


            item.style.display =
                nome.includes(texto)
                    ? ""
                    : "none";

        });

    });


    // SELEÇÃO


    checkboxes.forEach(function (checkbox) {

        checkbox.addEventListener("change", function () {

            const selecionadas = [];


            checkboxes.forEach(function (item) {

                if (item.checked) {

                    selecionadas.push(
                        item.value
                    );

                }

            });


            // Nenhuma selecionada

            if (selecionadas.length === 0) {

                botao.textContent =
                    `Selecione ${config.nome.toLowerCase()}`;

            }


            // Uma ou várias selecionadas

            else {

                botao.textContent =
                    selecionadas.join(", ");

            }

        });

    });

}


// CRIAR TODOS OS FILTROS


filtros.forEach(function (filtro) {

    criarCampoFiltro(filtro);

});

</script>