<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<h1>Filtrar Questões</h1>

<form id="filtrarQuestoes">
    <div class="my-3">
        <label for="palavra-chave">Palavra-chave</label><br>
        <div class="input-group mt-1">
            <input class="form-control" type="text" id="palavra-chave" name="palavra-chave"
                placeholder="Busque por palavra-chave">
        </div>
    </div>
    
    <div class="my-3">
        <label class="form-label">Disciplina</label>

        <div class="dropdown w-100">
            <button class="form-select text-start" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                Selecione as disciplinas
            </button>

            <ul class="dropdown-menu w-100 p-2">

                <li>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" value="Matemática">
                        <label class="form-check-label">
                            Matemática
                        </label>
                    </div>
                </li>

                <li>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" value="Português">
                        <label class="form-check-label">
                            Português
                        </label>
                    </div>
                </li>

                <li>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" value="História">
                        <label class="form-check-label">
                            História
                        </label>
                    </div>
                </li>

                <li>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" value="Geografia">
                        <label class="form-check-label">
                            Geografia
                        </label>
                    </div>
                </li>

            </ul>
        </div>
    </div>
</form>

<script>
    document.querySelectorAll('.dropdown').forEach(dropdown => {

        const botao = dropdown.querySelector('button');
        const checkboxes = dropdown.querySelectorAll('.form-check-input');

        checkboxes.forEach(checkbox => {

            checkbox.addEventListener('change', () => {

                const selecionadas = [];

                checkboxes.forEach(item => {
                    if (item.checked) {
                        selecionadas.push(item.value);
                    }
                });

                if (selecionadas.length === 0) {
                    botao.textContent = 'Selecione as disciplinas';
                } else {
                    botao.textContent = selecionadas.join(', ');
                }

            });

        });

    });
</script>