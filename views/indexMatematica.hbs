                    <img src="imagens/iconMatematica.png" alt>
                </div>
            </div>
        </div>

        <button class="seta">&gt;</button>

    </section>

    <section class="atalhos2">

        <div class="Materiais">
            <h2>Materiais</h2>
            <p>Exercite seu cérebro</p>
        </div>

        <div class="fundoQuestoes">

            <div class="resolverQuestoes">

                <div class="botaoCadastro">

                    <div id="modalMateria" class="modalMateria">
                        <div class="conteudoModal">
                            <h1>Selecione a matéria</h1>
                            <p id="nomeArquivo"></p>

                            <select id="selectMateria">

                                <option value>Escolha uma matéria</option>

                                <option value="Matemática Básica">Matemática Básica</option>
                                <option value="Conjuntos">Conjuntos</option>
                                <option value="Funções">Funções</option>
                                <option value="Módulo">Módulo</option>
                                <option value="Exponencial e Logaritmo">Exponencial e Logaritmo</option>
                                <option value="Geometria Plana">Geometria Plana</option>
                                <option value="Trigonometria">Trigonometria</option>
                                <option value="Matrizes">Matrizes</option>
                                <option value="Sistemas Lineares">Sistemas Lineares</option>
                                <option value="Geometria Espacial">Geometria Espacial</option>
                                <option value="Sequências e Progressões">Sequências e Progressões</option>
                                <option value="Análise Combinatória">Análise Combinatória</option>
                                <option value="Probabilidade">Probabilidade</option>
                                <option value="Estatística">Estatística</option>
                                <option value="Geometria Analítica">Geometria Analítica</option>
                                <option value="Números Complexos">Números Complexos</option>
                                <option value="Polinômios">Polinômios</option>

                            </select>

                            <div class="botoesModal">

                                <button type="button"
                                    id="cancelarMateria">Cancelar</button>
                                <button type="button"
                                    id="salvarMaterial">Salvar</button>

                            </div>
                        </div>
                    </div>

                    <div class="botaoCadastro">

                        <input type="file" id="fileInput" hidden>

                        <button type="button" class="btn"
                            id="btnCadastrar">+</button>

                    </div>

                </div>
                <div class="textoCadastro">

                    <h2>Cadastrar material</h2>

                    <p>Compartilhe seus conhecimentos<br>
                        e ajude outros usuários</p>

                </div>
            </div>

            <div class="divisor"></div>

            <div class="materiaisCadastrados">

                <h2>Materiais Cadastrados</h2>

                <div class="rolagemMateriais">

                    <table class="tabelaMateriais">

                        <thead>

                            <tr>
                                <th>Nome do material</th>
                                <th>Conteúdo</th>
                                <th>Ações</th>
                            </tr>

                        </thead>

                        <tbody id="listaMateriais">
                        </tbody>
                        
                    </table>

                </div>
            </div>
        </div>

    </section>
