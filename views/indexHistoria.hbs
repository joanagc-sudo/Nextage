    <section class="atalhos2">

        <div class="Materiais">
            <h2>Materiais</h2>
            <p>Exercite seu cérebro</p>
        </div>

        <div class="fundoQuestoes">

            <div class="resolverQuestoes">

                <div class="botaoCadastro">

                    <div id="modalMateria" class="modalMateria">
                        <div class="conteudoModal">
                            <h1>Selecione a matéria</h1>
                            <p id="nomeArquivo"></p>

                            <select id="selectMateria">

                                <option value>Escolha uma matéria</option>

                                <option value="Introdução à História Geral">Introdução à História Geral</option>
                                <option value="Idade Antiga">Idade Antiga</option>
                                <option value="Idade Média">Idade Média</option>
                                <option value="Idade Moderna">Idade Moderna</option>
                                <option value="Brasil Colônia">Brasil Colônia</option>
                                <option value="Idade Contemporânea">Idade Contemporânea</option>
                                <option value="Brasil Monárquico">Brasil Monárquico</option>
                                <option value="Século XX">Século XX</option>
                                <option value="Conflitos do Século XX">Conflitos do Século XX</option>
                                <option value="Primeira República">Primeira República</option>
                                <option value="Estado Novo e Populismo">Estado Novo e Populismo</option>
                                <option value="Ditadura Militar Brasileira">Ditadura Militar Brasileira</option>
                                <option value="Nova República">Nova República</option>
                                <option value="Eletrodinâmica">Tempo Presente</option>
                                <option value="Eletrodinâmica">História da Arte</option>

                            </select>

                            <div class="botoesModal">

                                <button type="button"
                                    id="cancelarMateria">Cancelar</button>
                                <button type="button"
                                    id="salvarMaterial">Salvar</button>

                            </div>
                        </div>
                    </div>

                    <div class="botaoCadastro">

                        <input type="file" id="fileInput" hidden>

                        <button type="button" class="btn"
                            id="btnCadastrar">+</button>

                    </div>

                </div>
                <div class="textoCadastro">

                    <h2>Cadastrar material</h2>

                    <p>Compartilhe seus conhecimentos<br>
                        e ajude outros usuários</p>

                </div>
            </div>

            <div class="divisor"></div>

            <div class="materiaisCadastrados">

                <h2>Materiais Cadastrados</h2>

                <div class="rolagemMateriais">

                    <table class="tabelaMateriais">

                        <thead>

                            <tr>
                                <th>Nome do material</th>
                                <th>Conteúdo</th>
                                <th>Ações</th>
                            </tr>

                        </thead>

                        <tbody id="listaMateriais">
                        </tbody>
                        
                    </table>

                </div>
            </div>
        </div>

    </section>
