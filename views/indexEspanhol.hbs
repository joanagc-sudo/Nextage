<link rel="stylesheet" href="styleMateriais.css">
<script src="/js/scriptMateriais.js" defer></script>

<br>

<h1>Conteúdos</h1>
<div style="margin: 40px auto; width: 92%;">
    <div class="seletorDisciplina">

        <button type="button" id="btnDisciplina" class="btnDisciplina">
            <span id="disciplinaAtual">Biologia</span>
            <span id="setaDisciplina">▼</span>
        </button>

        <div id="listaDisciplinas" class="listaDisciplinas">

            <button type="button" data-disciplina="Geografia">
                Geografia
            </button>

            <button type="button" data-disciplina="Biologia">
                Biologia
            </button>

            <button type="button" data-disciplina="Espanhol">
                Espanhol
            </button>

            <button type="button" data-disciplina="Física">
                Física
            </button>

            <button type="button" data-disciplina="Filosofia">
                Filosofia
            </button>

            <button type="button" data-disciplina="História">
                História
            </button>

            <button type="button" data-disciplina="Inglês">
                Inglês
            </button>

            <button type="button" data-disciplina="Matemática">
                Matemática
            </button>

            <button type="button" data-disciplina="Português">
                Português
            </button>

            <button type="button" data-disciplina="Química">
                Química
            </button>

            <button type="button" data-disciplina="Sociologia">
                Sociologia
            </button>

        </div>

    </div>
</div>

<section class="atalhos">

    <button class="seta">&lt;</button>

    <div class="atalhos1">

        <div class="assuntos">
            <div class="icones">
                <div class="assuntog1"
                    data-materia="Género Textuales">Género Textuales
                    <img src="imagens/iconEspanhol.png" alt>
                </div>
                <div class="assuntog2" data-materia="Classifiação dos Seres Vivos">Gramatica y Morfología
                    <img src="imagens/iconEspanhol.png" alt>
                </div>
                <div class="assuntog3" data-materia="Pronombres">Pronombres
                    <img src="imagens/iconEspanhol.png" alt>
                </div>
                <div class="assuntog4" data-materia="Tempos Verbales">Tempos Verbales
                    <img src="imagens/iconEspanhol.png" alt>
                </div>
                <div class="assuntog5" data-materia="Vocabulario">Vocabulario
                    Brasileiro
                    <img src="imagens/iconEspanhol.png" alt>
                </div>
                <div class="assuntog6" data-materia="Cultura Hispânica">Cultura Hispânica
                    <img src="imagens/iconEspanhol.png" alt>
                </div>
            </div>
        </div>

        <button class="seta">&gt;</button>

    </section>

    <section class="atalhos2">

        <div class="Materiais">
            <h2>Materiais</h2>
            <p>Exercite seu cérebro</p>
        </div>

        <div class="fundoQuestoes">

            <div class="resolverQuestoes">

                <div class="botaoCadastro">

                    <div id="modalMateria" class="modalMateria">
                        <div class="conteudoModal">
                            <h1>Selecione a matéria</h1>
                            <p id="nomeArquivo"></p>

                            <select id="selectMateria">

                                <option value>Escolha uma matéria</option>

                                <option value="Género Textuales">Género Textuales</option>
                                <option value="Gramatica y Morfología">Gramatica y Morfología</option>
                                <option value="Pronombres">Pronombres</option>
                                <option value="Tempos Verbales">Tempos Verbales</option>
                                <option value="Vocabulario">Vocabulario</option>
                                <option value="Cultura Hispânica">Cultura Hispânica</option>

                            </select>

                            <div class="botoesModal">

                                <button type="button"
                                    id="cancelarMateria">Cancelar</button>
                                <button type="button"
                                    id="salvarMaterial">Salvar</button>

                            </div>
                        </div>
                    </div>

                    <div class="botaoCadastro">

                        <input type="file" id="fileInput" hidden>

                        <button type="button" class="btn"
                            id="btnCadastrar">+</button>

                    </div>

                </div>
                <div class="textoCadastro">

                    <h2>Cadastrar material</h2>

                    <p>Compartilhe seus conhecimentos<br>
                        e ajude outros usuários</p>

                </div>
            </div>

            <div class="divisor"></div>

            <div class="materiaisCadastrados">

                <h2>Materiais Cadastrados</h2>

                <div class="rolagemMateriais">

                    <table class="tabelaMateriais">

                        <thead>

                            <tr>
                                <th>Nome do material</th>
                                <th>Conteúdo</th>
                                <th>Ações</th>
                            </tr>

                        </thead>

                        <tbody id="listaMateriais">

                        </tbody>

                    </table>

                </div>

            </div>
        </div>

    </section>
