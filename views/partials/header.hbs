<link rel="stylesheet" href="/styleHeader.css">

<header class="navbar">

    <div class="logo">
        <span>Nextage</span>
    </div>

    <nav>
        <a href="/tela-inicial">Início</a>
        <a href="/materiais">Materiais</a>
        <a href="/questoes">Questões</a>
        <a href="/desempenho">Desempenho</a>
    </nav>

    <div class="usuario-container">

        <button class="usuario" id="botaoUsuario" type="button"
            aria-label="Abrir menu do usuário">

            <img id="fotoPerfilNavbar"
                src="{{#if usuario.foto}}{{usuario.foto}}{{else}}/imagens/usuario.png{{/if}}"
                alt="Perfil">

        </button>

        <div class="menu-usuario" id="menuUsuario">

            <div class="perfil-info">

                <img id="fotoPerfilMenu"
                    src="{{#if usuario.foto}}{{usuario.foto}}{{else}}/imagens/usuario.png{{/if}}"
                    alt="Perfil">

                <div>
                    <strong>
                        {{#if usuario}}
                            {{usuario.nome}}
                        {{else}}
                            Usuário
                        {{/if}}
                    </strong>

                    <span>
                        {{#if usuario}}
                            {{usuario.email}}
                        {{else}}
                            usuario@email.com
                        {{/if}}
                    </span>
                </div>

            </div>

            <div class="separador"></div>

            <button class="opcao-menu" id="editarConta" type="button">
                <i class="bi bi-pencil-square"></i>
                <span>Editar conta</span>
            </button>

            <button class="opcao-menu" id="trocarConta" type="button">
                <i class="bi bi-arrow-left-right"></i>
                <span>Trocar de conta</span>
            </button>

            <button class="opcao-menu" id="alterarFoto" type="button">
                <i class="bi bi-camera"></i>
                <span>Alterar foto</span>
            </button>

            <input type="file" id="inputFoto" accept="image/*" hidden>

            <div class="separador"></div>

            <a href="/admin/login" class="opcao-menu administrador" id="espacoAdmin">
                <i class="bi bi-shield-lock"></i>
                <span>Espaço do administrador</span>
            </a>

            <div class="separador"></div>

            <button class="opcao-menu sair" id="sair" type="button">
                <i class="bi bi-box-arrow-right"></i>
                <span>Sair</span>
            </button>

        </div>

    </div>

</header>

<script src="/js/scriptHeader.js"></script>