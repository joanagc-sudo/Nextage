<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<header class="navbar">

    <!-- LOGO -->
    <div class="logo">
        <span>Nextage</span>
    </div>

    <nav>
        <a href="/tela-inicial">Início</a>
        <a href="/materiais">Materiais</a>
        <a href="/questoes">Questões</a>
    </nav>

    <div class="usuario-container">

        <!-- Botão do usuário -->
        <button class="usuario" id="botaoUsuario">

            <img
                id="fotoPerfilNavbar"
                src="{{#if usuario.foto}}{{usuario.foto}}{{else}}/imagens/usuario.png{{/if}}"
                alt="Perfil"
            >

        </button>

        <div class="menu-usuario" id="menuUsuario">


            <!-- INFORMAÇÕES DO PERFIL -->
            <div class="perfil-info">

                <img
                    id="fotoPerfilMenu"
                    src="{{#if usuario.foto}}{{usuario.foto}}{{else}}/imagens/usuario.png{{/if}}"
                    alt="Perfil"
                >
                <div>

                    <strong>
                        {{#if usuario}}
                            {{usuario.nome}}
                        {{else}}
                            Usuário
                        {{/if}}
                    </strong>

                    <span>
                        {{#if usuario}}
                            {{usuario.email}}
                        {{else}}
                            usuario@email.com
                        {{/if}}
                    </span>

                </div>

            </div>


            <div class="separador"></div>

            <button
                class="opcao-menu"
                id="trocarConta"
            >

                <i class="bi bi-arrow-left-right"></i>

                <span>
                    Trocar de conta
                </span>

            </button>

            <button
                class="opcao-menu"
                id="alterarFoto"
            >

                <i class="bi bi-camera"></i>

                <span>
                    Alterar foto
                </span>

            </button>

            <input
                type="file"
                id="inputFoto"
                accept="image/*"
                hidden
            >


            <div class="separador"></div>

            <button
                class="opcao-menu sair"
                id="sair"
            >

                <i class="bi bi-arrow-return-right"></i>
                <span>
                    Sair
                </span>

            </button>

        </div>
    </div>

</header>

<script src="/js/scriptHeaderl.js"></script>