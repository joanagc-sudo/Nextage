 <link rel="stylesheet" href="styleCadastroAluno.css">

    <!-- Linha (row) -->
    <div class="row">
        <!-- Coluna (col esquerda) -->
        <div class="col-lg-6 painel-esquerdo">
            <section>
                <h1>Crie sua conta e dê o próximo <br>passo na sua
                    jornada</h1>
                <p class =>No Nextage, você encontra tudo o que
                    precisa<br>para
                    estudar,
                    organizar seus conteúdos e<br> evoluir todos os
                    dias</p>
            </section>
            <div class="item">
                <div class="icone">
                    <img src="imagens/iconLivro.png" alt="Ícone">
                </div>

                <div class="texto">
                    <h2>Aprendizado que te acompanha</h2>
                    <p>Acesse materiais, exercícios e recursos sempre
                        que quiser.</p>
                </div>
            </div>
            <div class="item">
                <div class="icone">
                    <img src="imagens/iconAlvo.png" alt="Ícone">
                </div>

                <div class="texto">
                    <h2>Organize e acompanhe seu progresso</h2>
                    <p>Tenha clareza da sua evolução e foque no que
                        realmente importa.</p>
                </div>
            </div>
            <div class="item">
                <div class="icone">
                    <img src="imagens/iconSocial.png" alt="Ícone">
                </div>

                <div class="texto">
                    <h2>Conecte-se com outros estudantes</h2>
                    <p>Participe do fórum, troque ideias e aprenda junto
                        com
                        a comunidade.</p>
                </div>
            </div>

            <img src="imagens/rodape.png" class="imagem-rodape" alt>
        </div>
        <!-- Coluna (col direita) -->
        <div class="col-lg-6 painel-direito">

            <div class="d-flex flex-column justify-content-center">

                <h2 class="textoConta">Criar conta</h2>

                <p class="conta">Preencha seus dados para começar a usar
                    o
                    Nextage.</p>

                <form>
                    <div class="my-3">
                        <label for="nome">Nome Completo</label><br>
                        <div class="input-group mt-1">
                            <span class="input-group-text"
                                id="basic-addon1">
                                <i class="bi bi-person"></i>
                            </span>

                            <input class="form-control" type="text"
                                id="nome" name="nome"
                                placeholder="Digite seu nome completo">
                        </div>
                    </div>

                    <div class="my-3">
                        <label for="email">E-mail</label><br>
                        <div class="input-group mt-1">
                            <span class="input-group-text"
                                id="basic-addon1">
                                <i class="bi bi-envelope"></i>
                            </span>

                            <input class="form-control" type="email"
                                id="email" name="email"
                                placeholder="Digite seu e-mail">
                        </div>
                    </div>

                    <div>

                    </div>

                    <div class="my-3">
                        <label for="senha">Senha</label><br>
                        <div class="input-group mt-1">
                            <span class="input-group-text"
                                id="basic-addon1">
                                <i class="bi bi-lock"></i>
                            </span>

                            <input class="form-control" type="password"
                                id="senha" name="senha"
                                placeholder="Crie uma senha segura">
                        </div>
                    </div>
                    <div class="my-3">

                    </div>
                    <div class="my-3">
                        <label for="confirmarSenha">Confirmar
                            senha</label>
                        <div class="input-group mt-1">
                            <span class="input-group-text"
                                id="basic-addon1">
                                <i class="bi bi-lock"></i>
                            </span>

                            <input class="form-control" type="password"
                                id="confirmarSenha"
                                name="confirmarSenha"
                                placeholder="Confirme sua senha">
                        </div>
                    </div>

                    <div class="my-3">
                        <label for="dataNascimento">Data de nascimento
                            (opcional)</label>
                        <div class="input-group mt-1">
                            <span class="input-group-text"
                                id="basic-addon1">
                                <i class="bi bi-calendar4-week"></i>
                            </span>

                            <input class="form-control" type="date"
                                id="dataNascimento"
                                name="dataNascimento"
                                placeholder="DD/MM/AAAA">
                        </div>
                    </div>
                    <div>
                        <button type="button" class="btn btn-primary"
                            onclick="mostrarAlerta()">
                            Criar minha conta
                        </button>
                    </div>
                </form>

                <p class="entrar">
                    Já tem uma conta?
                    <a href="indexTelaLogin.html">Entrar</a>
                </p>

            </div>

        </div>
    </div>

<div id="alerta-sucesso"
    class="alert alert-success d-flex align-items-center d-none"
    role="alert">

    <svg class="bi flex-shrink-0 me-2"
        width="20"
        height="20"
        role="img"
        aria-label="Sucesso:">
        <use xlink:href="#check-circle-fill"></use>
    </svg>

    <div>
        Conta criada com sucesso!
    </div>
</div>

<script>
function mostrarAlerta() {
    const alerta = document.getElementById("alerta-sucesso");

    alerta.classList.remove("d-none");

    setTimeout(function () {
        window.location.href = "/tela-inicial";
    }, 500);
}
</script>