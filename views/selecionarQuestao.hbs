<link rel="stylesheet" href="/styleAlterarQuestoes.css">

<div class="painel-alterar">

    <div class="container-alterar">

        <h1>Alterar ou excluir questão</h1>

        <p>Digite o ID da questão que deseja modificar.</p>

        <div class="card-alterar">

            <form id="formBuscarQuestao">

                <label for="id_questao">
                    ID da questão
                </label>

                <input
                    type="number"
                    id="id_questao"
                    min="1"
                    placeholder="Digite o ID"
                    required>

                <div class="botoes-alterar">

                    <a href="/tela-inicial">
                        Voltar
                    </a>

                    <button type="submit">
                        Buscar questão
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<script src="/js/scriptAlterarQuestao.js"></script>