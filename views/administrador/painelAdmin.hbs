
<link rel="stylesheet" href="/stylePainelAdmin.css">

<div class="painel-admin">

    <div class="painel-admin-container">

        <!-- Cabeçalho -->
        <div class="painel-admin-header">
            <div>
                <h1>Espaço do administrador</h1>
                <p>Bem-vindo, {{admin.nome}}!</p>
            </div>

            <a href="/admin/logout" class="botao-sair">Sair</a>
        </div>

        <!-- Introdução -->
        <div class="painel-admin-introducao">
            <h2>O que deseja gerenciar?</h2>
            <p>Escolha uma das opções abaixo para organizar os conteúdos do Nextage.</p>
        </div>

        <!-- Cards de gerenciamento -->
        <div class="painel-admin-conteudo">

            <!-- Materiais de estudo -->
            <div class="card-admin">

                <div class="icone-admin">
                    <i class="bi bi-journal-bookmark"></i>
                </div>

                <h2>Materiais de estudo</h2>

                <p>
                    Cadastre, edite e exclua materiais para ajudar
                    os alunos na preparação.
                </p>

                <a href="/admin/materiais">Gerenciar materiais</a>

            </div>

            <!-- Questões -->
            <div class="card-admin">

                <div class="icone-admin">
                    <i class="bi bi-question-circle"></i>
                </div>

                <h2>Questões</h2>

                <p>
                    Cadastre, edite e exclua questões,
                    alternativas e respostas corretas.
                </p>

                <a href="/cadastro-questoes">Gerenciar questões</a>

            </div>

            <!-- Flashcards -->
            <div class="card-admin">

                <div class="icone-admin">
                    <i class="bi bi-card-text"></i>
                </div>

                <h2>Flashcards</h2>

                <p>
                    Cadastre, edite e exclua flashcards para ajudar
                    os alunos a revisar os conteúdos.
                </p>

                <a href="/admin/flashcards">Gerenciar flashcards</a>

            </div>

        </div>

    </div>

</div>
