{{> message}}
<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<link rel="stylesheet" href="styleCadastroQuestoes.css">
<link rel="stylesheet" href="/stylePainelAdmin.css">

<div class="painel-admin">

    <div class="painel-admin-container">

        <!-- Cabeçalho -->
        <div class="painel-admin-header">
            <div>
                <h1>Espaço do administrador</h1>
                <p>Bem-vindo, {{admin.nome}}!</p>
            </div>

            <a href="/admin/logout" class="botao-sair">Sair</a>
        </div>

        <!-- Introdução -->
        <div class="painel-admin-introducao">
            <h2>O que deseja gerenciar?</h2>
            <p>Escolha uma das opções abaixo para organizar os conteúdos do Nextage.</p>
        </div>

        <!-- Cards de gerenciamento -->
        <div class="painel-admin-conteudo">

            <!-- Materiais de estudo -->
            <div class="card-admin">

                <div class="icone-admin">
                    <i class="bi bi-journal-bookmark"></i>
                </div>

                <h2>Materiais de estudo</h2>

                <p>
                    Cadastre, edite e exclua materiais para ajudar
                    os alunos na preparação.
                </p>

                <a href="/admin/materiais">Gerenciar materiais</a>

            </div>

            <!-- Questões -->
            <div class="card-admin">

                <div class="icone-admin">
                    <i class="bi bi-question-circle"></i>
                </div>

                <h2>Questões</h2>

                <p>
                    Cadastre, edite e exclua questões,
                    alternativas e respostas corretas.
                </p>

                <div class="botoes-gerenciar">
                    <a href="/cadastro-questoes">Cadastrar</a>
                    <a href="#modalSelecionarQuestao" data-bs-toggle="modal">
                        Alterar/Deletar
                    </a>
                </div>
            </div>

            <!-- Flashcards -->
            <div class="card-admin">

                <div class="icone-admin">
                    <i class="bi bi-card-text"></i>
                </div>

                <h2>Flashcards</h2>

                <p>
                    Cadastre, edite e exclua flashcards para ajudar
                    os alunos a revisar os conteúdos.
                </p>

                <a href="/admin/flashcards">Gerenciar flashcards</a>

            </div>

        </div>

    </div>

</div>
<!-- MODAL para selecionar ID -->
<div class="modal fade" id="modalSelecionarQuestao" tabindex="-1" aria-labelledby="tituloModalQuestao"
    aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="tituloModalQuestao">
                    Alterar ou excluir questão
                </h5>

                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>

            <div class="modal-body">
                <p>Digite o ID da questão que deseja modificar.</p>

                <label for="id_questao" class="form-label">
                    ID da questão
                </label>

                <input type="number" class="form-control" id="id_questao" min="1" placeholder="Digite o ID" required>

                <div class="d-flex justify-content-end gap-2 mt-3">

                    <a href="#" data-bs-dismiss="modal" id="cancela">
                        Cancelar
                    </a>

                    <a href="#" id="btnBuscarQuestao">
                        Buscar questão
                    </a>

                </div>
            </div>

        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/scriptAdmin.js"></script>