
<link rel="stylesheet" href="/styleFlashcardsAdmin.css">

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="gerenciar-flashcards">

    <div class="flashcards-container">

        <!-- CABEÇALHO -->
        <div class="flashcards-header">

            <div>
                <h1>
                    {{#if editando}}
                        Editar flashcard
                    {{else}}
                        Novo flashcard
                    {{/if}}
                </h1>

                <p>Preencha as informações do cartão de revisão.</p>
            </div>

            <a href="/admin/flashcards" class="btn-voltar">
                <i class="bi bi-arrow-left"></i>
                Voltar
            </a>

        </div>

        <!-- FORMULÁRIO -->
        <div class="form-flashcard">

            <form
                action="{{#if editando}}/admin/flashcards/editar/{{flashcard.id_flashcard}}{{else}}/admin/flashcards/novo{{/if}}"
                method="POST"
            >

                <!-- FILTROS DE DISCIPLINA E CONTEÚDO -->
                <div class="filtros-flashcard">

                    <!-- DISCIPLINA -->
                    <div class="campo-flashcard">

                        <label for="filtroDisciplinaFlashcard">
                            Disciplina
                        </label>

                        <select
                            id="filtroDisciplinaFlashcard"
                            required
                        >

                            <option value="">
                                Selecione uma disciplina
                            </option>

                        </select>

                    </div>

                    <!-- CONTEÚDO -->
                    <div class="campo-flashcard">

                        <label for="id_conteudo">
                            Conteúdo
                        </label>

                        <select
                            name="id_conteudo"
                            id="id_conteudo"
                            required
                        >

                            <option value="">
                                Selecione um conteúdo
                            </option>

                            {{#each conteudos}}

                                <option
                                    value="{{id_conteudo}}"
                                    data-disciplina="{{nome_disciplina}}"
                                    {{#if selecionado}}selected{{/if}}
                                >
                                    {{nome_conteudo}}
                                </option>

                            {{/each}}

                        </select>

                    </div>

                </div>

                <!-- PERGUNTA -->
                <div class="campo-flashcard">

                    <label for="pergunta">
                        Pergunta
                    </label>

                    <textarea
                        name="pergunta"
                        id="pergunta"
                        placeholder="Digite a pergunta do flashcard..."
                        required
                    >{{flashcard.pergunta}}</textarea>

                </div>

                <!-- RESPOSTA -->
                <div class="campo-flashcard">

                    <label for="resposta">
                        Resposta
                    </label>

                    <textarea
                        name="resposta"
                        id="resposta"
                        placeholder="Digite a resposta do flashcard..."
                        required
                    >{{flashcard.resposta}}</textarea>

                </div>

                <!-- BOTÕES -->
                <div class="form-flashcard-botoes">

                    <a
                        href="/admin/flashcards"
                        class="btn-cancelar"
                    >
                        Cancelar
                    </a>

                    <button
                        type="submit"
                        class="btn-salvar"
                    >

                        <i class="bi bi-check-circle"></i>

                        {{#if editando}}
                            Salvar alterações
                        {{else}}
                            Cadastrar flashcard
                        {{/if}}

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<script src="/js/scriptFormFlashcards.js"></script>
