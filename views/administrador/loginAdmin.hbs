<div class="login-admin">

    <div class="login-admin-card">

        <div class="login-admin-icon">
            <i class="bi bi-shield-lock"></i>
        </div>

        <h1>Espaço do administrador</h1>

        <p>Entre com suas credenciais para acessar a área administrativa do Nextage.</p>

        {{#if query.error}}

            <div class="mensagem-erro">
                {{query.error}}
            </div>

        {{/if}}

        <form action="/admin/login" method="POST">

            <div class="campo-admin">

                <label for="email">E-mail</label>

                <input type="email" id="email" name="email" placeholder="Digite seu e-mail" required>

            </div>

            <div class="campo-admin">

                <label for="senha"> Senha</label>

                <inputtype="password" id="senha" name="senha" placeholder="Digite sua senha" required>

            </div>

            <button type="submit">Entrar</button>

            <a href="/tela-inicial">Voltar para o Nextage</a>

        </form>

    </div>

</div>
