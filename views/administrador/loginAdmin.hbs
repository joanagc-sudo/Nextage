
<link rel="stylesheet" href="/styleLoginAdmin.css">

<div class="login-admin">

    <div class="login-admin-card">

        <h1>Bem-vindo ao Nextage!</h1>

        <p>Entre com suas credenciais para acessar
            a área administrativa. </p>

        {{#if query.error}}
            <div class="mensagem-erro">
                {{query.error}}
            </div>
        {{/if}}

        <form action="/admin/login" method="POST">

            <div class="campo-admin">
                <label for="email">E-mail</label>
                <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="Insira seu e-mail"
                    required >
            </div>

            <div class="campo-admin">
                <label for="senha">Senha</label>
                <input
                    type="password"
                    id="senha"
                    name="senha"
                    placeholder="Insira sua senha"
                    required>
            </div>

            <button type="submit">Login</button>

            <a href="/tela-inicial">Voltar para o Nextage</a>

        </form>

    </div>

</div>
