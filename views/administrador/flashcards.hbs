<link rel="stylesheet" href="/styleFlashcardsAdmin.css">

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<a href="/admin" class="voltar-admin" title="Voltar ao painel administrativo">
    <i class="bi bi-arrow-left"></i>
</a>

<div class="gerenciar-flashcards">

    <div class="flashcards-container">

        <div class="flashcards-header">
            <div>
                <h1>Gerenciar flashcards</h1>
                <p>Organize os cartões de revisão dos alunos.</p>
            </div>
        </div>

        <div class="flashcards-acoes">
            <a href="/admin/flashcards/novo" class="btn-novo">
                <i class="bi bi-plus-circle"></i>
                Novo flashcard
            </a>
        </div>

        {{#if flashcards.length}}

            <!-- FILTROS -->
            <div class="filtros-flashcards">

                <div class="campo-filtro">
                    <label for="filtroDisciplina">
                        Disciplina
                    </label>

                    <select id="filtroDisciplina">
                        <option value="">Todas as disciplinas</option>
                    </select>
                </div>

                <div class="campo-filtro">
                    <label for="filtroConteudo">
                        Conteúdo
                    </label>

                    <select id="filtroConteudo">
                        <option value="">Todos os conteúdos</option>
                    </select>
                </div>

            </div>

            <div class="flashcards-lista" id="listaFlashcards">

                {{#each flashcards}}

                    <div
                        class="flashcard-admin"
                        data-disciplina="{{nome_disciplina}}"
                        data-conteudo="{{nome_conteudo}}"
                    >

                        <div class="flashcard-info">

                            <span class="flashcard-disciplina">
                                {{nome_disciplina}}
                            </span>

                            <span class="flashcard-conteudo">
                                {{nome_conteudo}}
                            </span>

                            <h3>Pergunta</h3>
                            <p>{{pergunta}}</p>

                            <h3>Resposta</h3>
                            <p>{{resposta}}</p>

                        </div>

                        <div class="flashcard-botoes">

                            <a
                                href="/admin/flashcards/editar/{{id_flashcard}}"
                                class="btn-editar"
                            >
                                <i class="bi bi-pencil-square"></i>
                                Editar
                            </a>

                            <form
                                action="/admin/flashcards/excluir/{{id_flashcard}}"
                                method="POST"
                                onsubmit="return confirm('Deseja realmente excluir este flashcard?')"
                            >

                                <button type="submit" class="btn-excluir">
                                    <i class="bi bi-trash"></i>
                                    Excluir
                                </button>

                            </form>

                        </div>

                    </div>

                {{/each}}

            </div>

            <!-- MENSAGEM QUANDO O FILTRO NÃO ENCONTRAR CARTÕES -->
            <div class="flashcards-vazio" id="mensagemFiltro" style="display: none;">
                <i class="bi bi-search"></i>
                <h2>Nenhum flashcard encontrado</h2>
                <p>Tente selecionar outra disciplina ou conteúdo.</p>
            </div>

        {{else}}

            <div class="flashcards-vazio">
                <i class="bi bi-card-text"></i>
                <h2>Nenhum flashcard cadastrado</h2>
                <p>Comece criando seu primeiro flashcard!</p>
            </div>

        {{/if}}

    </div>

</div>


<script src="/js/scriptFlashcardsAdmin.js"></script>