    <section class="atalhos2">

        <div class="Materiais">
            <h2>Materiais</h2>
            <p>Exercite seu cérebro</p>
        </div>

        <div class="fundoQuestoes">

            <div class="resolverQuestoes">

                <div class="botaoCadastro">

                    <div id="modalMateria" class="modalMateria">
                        <div class="conteudoModal">
                            <h1>Selecione a matéria</h1>
                            <p id="nomeArquivo"></p>

                            <select id="selectMateria">

                                <option value>Escolha uma matéria</option>

                                <option value="Introdução à Física">Introdução à Física</option>
                                <option value="Cinemática">Cinemática</option>
                                <option value="Dinâmica">Dinâmica</option>
                                <option value="Estática">Estática</option>
                                <option value="Movimento Circular">Movimento Circular</option>
                                <option value="Gravitação Universal">Gravitação Universal</option>
                                <option value="Trabalho e Energia">Trabalho e Energia</option>
                                <option value="Quantidade de Movimento">Quantidade de Movimento</option>
                                <option value="Fluidos">Fluidos</option>
                                <option value="Movimento Harmônico Simples">Movimento Harmônico Simples</option>
                                <option value="Ondulatória">Ondulatória</option>
                                <option value="Termologia">Termologia</option>
                                <option value="Eletrostática">Eletrostática</option>
                                <option value="Eletrodinâmica">Eletrodinâmica</option>
                                <option value="Magnetismo">Magnetismo</option>
                                <option value="Óptica">Óptica</option>
                                <option value="Física Moderna">Física Moderna</option>
                                <option value="Análise Dimensional">Análise Dimensional</option>

                            </select>

                            <div class="botoesModal">

                                <button type="button"
                                    id="cancelarMateria">Cancelar</button>
                                <button type="button"
                                    id="salvarMaterial">Salvar</button>

                            </div>
                        </div>
                    </div>

                    <div class="botaoCadastro">

                        <input type="file" id="fileInput" hidden>

                        <button type="button" class="btn"
                            id="btnCadastrar">+</button>

                    </div>

                </div>
                <div class="textoCadastro">

                    <h2>Cadastrar material</h2>

                    <p>Compartilhe seus conhecimentos<br>
                        e ajude outros usuários</p>

                </div>
            </div>

            <div class="divisor"></div>

            <div class="materiaisCadastrados">

                <h2>Materiais Cadastrados</h2>

                <div class="rolagemMateriais">

                    <table class="tabelaMateriais">

                        <thead>

                            <tr>
                                <th>Nome do material</th>
                                <th>Conteúdo</th>
                                <th>Ações</th>
                            </tr>

                        </thead>

                        <tbody id="listaMateriais">
                        </tbody>
                        
                    </table>

                </div>
            </div>
        </div>

    </section>
