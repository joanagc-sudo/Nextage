<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<link rel="stylesheet" href="styleQuestoes.css">

<div class="filtro">

    <h1>Filtrar Questões</h1>

    <div class="containerFiltro">

        <form id="filtrarQuestoes">

            <!-- PALAVRA-CHAVE -->
            <div class="campo-filtro">

                <label for="palavra-chave" class="form-label">
                    Palavra-chave
                </label>

                <input class="form-control" type="text" id="palavra-chave"
                    name="palavra-chave"
                    placeholder="Busque por palavra-chave">

            </div>

            <!-- CAMPOS CRIADOS PELO JAVASCRIPT -->
            <div id="containerFiltros"></div>

        </form>

        <!-- QUESTÕES QUE -->
        <div class="campo-filtro questoes-filtro">

            <label for="questoes-que" class="form-label">
                Questões que:
            </label>
            <div class="btn-group" role="group">

                <input type="checkbox" class="btn-check" id="btncheck1">
                <label class="btn btn-outline-custom" for="btncheck1">
                    Não resolvi
                </label>

                <input type="checkbox" class="btn-check" id="btncheck2">
                <label class="btn btn-outline-custom" for="btncheck2">
                    Resolvi
                </label>

                <input type="checkbox" class="btn-check" id="btncheck3">
                <label class="btn btn-outline-custom" for="btncheck3">
                    Acertei
                </label>

                <input type="checkbox" class="btn-check" id="btncheck4">
                <label class="btn btn-outline-custom" for="btncheck4">
                    Errei
                </label>

            </div>

        </div>
        <button type="button" class="btn btn-primary" id="filtrar">
                <i class="bi bi-sort-down"></i>  FILTRAR
            </button>
    </div>

</div>
<div class="questoes">

    {{#each questoes}}
    <div class="questao card p-3 my-4" data-id-questao="{{id_questao}}">

        <p class="identificacao text-muted">
            {{vestibular}} ({{banca}}) {{ano}}
            {{#if disciplinas}} - {{disciplinas}}{{/if}}
            {{#if conteudos}} - {{conteudos}}{{/if}}
        </p>

        <p class="enunciado">{{enunciado}}</p>

        {{#if tem_imagem}}
        <img src="/questoes/{{id_questao}}/imagem" class="img-fluid mb-3"
            loading="lazy"
            alt="Imagem da questão {{id_questao}}">
        {{/if}}

        <div class="alternativas">
            {{#each alternativas}}
            <div class="form-check">
                <input class="form-check-input" type="radio"
                    name="questao-{{../id_questao}}"
                    id="q{{../id_questao}}-{{id_alternativas}}"
                    value="{{id_alternativas}}">

                <label class="altern form-check-label"
                    for="q{{../id_questao}}-{{id_alternativas}}">
                    <strong>{{letra}})</strong> {{texto}}
                </label>
            </div>
            {{/each}}
        </div>

        <div class="mt-3">
            <button type="button" class="btn btn-primary btn-verificar"
                data-questao="{{id_questao}}">
                Verificar resposta
            </button>
        </div>

        <div class="resultado mt-2"></div>
    </div>
    {{else}}
    <p>Nenhuma questão encontrada.</p>
    {{/each}}

</div>

<script src="/js/scriptQuestoes.js"></script>