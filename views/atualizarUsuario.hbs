
<link rel="stylesheet" href="/styleAtualizarUsuario.css">

<div class="painel-usuario">

    <div class="painel-usuario-container">

        <div class="painel-usuario-header">

            <div>
                <h1>Minha conta</h1>
                <p>Gerencie e atualize suas informações pessoais.</p>
            </div>

            <a href="/tela-inicial" class="botao-voltar">
                Voltar
            </a>

        </div>

        <div class="card-usuario">

            <h2>Dados pessoais</h2>

            <p class="descricao">
                Mantenha suas informações atualizadas no Nextage.
            </p>

            {{#if query.success}}
                <div class="alert alert-success">
                    {{query.success}}
                </div>
            {{/if}}

            {{#if query.error}}
                <div class="alert alert-danger">
                    {{query.error}}
                </div>
            {{/if}}

            <form action="/atualizar-usuario" method="POST">

                <div class="grupo-campo">
                    <label for="nome">Nome completo</label>

                    <input
                        type="text"
                        id="nome"
                        name="nome"
                        value="{{usuario.nome}}"
                        required>
                </div>

                <div class="grupo-campo">
                    <label for="email">E-mail</label>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        value="{{usuario.email}}"
                        required>
                </div>

                <div class="grupo-campo">
                    <label for="dataNascimento">
                        Data de nascimento
                    </label>

                    <input
                        type="date"
                        id="dataNascimento"
                        name="dataNascimento"
                        value="{{formatDate usuario.data_nascimento}}"
                        required>
                </div>

                <div class="secao-senha">

                    <h3>Segurança da conta</h3>

                    <p>
                        Caso queira alterar sua senha,
                        digite uma nova abaixo.
                        Se não quiser, deixe em branco.
                    </p>

                    <div class="grupo-campo">
                        <label for="senha">Nova senha</label>

                        <input
                            type="password"
                            id="senha"
                            name="senha"
                            placeholder="Digite sua nova senha">
                    </div>

                </div>

                <div class="botoes-usuario">

                    <a href="/tela-inicial"
                       class="botao-cancelar">
                        Cancelar
                    </a>

                    <button type="submit"
                            class="botao-salvar">
                        Salvar alterações
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>
