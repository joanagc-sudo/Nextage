{{> message}}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<link rel="stylesheet" href="styleGerenciarUsuarios.css">

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="gerenciar-usuarios">

    <a href="/admin" class="voltar-admin" title="Voltar ao painel administrativo">
        <i class="bi bi-arrow-left"></i>
    </a>

    <div class="usuarios-container">

        <div class="usuarios-header">

            <div>
                <h1>Administrar usuários</h1>
                <p>{{total}} usuário(s) cadastrado(s)</p>
            </div>

           

        </div>

        <div class="usuarios-acoes">
            <div>
            <label>Buscar por nome ou e-mail</label><br>
            <input type="search" id="busca" class="campo-busca input-group mt-1" placeholder="Digite aqui...">
            </div>
            <button type="button" id="btnNovoUsuario" class="btn-novo">
                <i class="bi bi-person-plus-fill"></i> Novo usuário
            </button>
        </div>

        <p id="alerta" class="alerta-usuarios" hidden></p>

        <div class="tabela-wrapper">

            <table id="tabelaUsuarios" class="tabela-usuarios">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nome</th>
                        <th>E-mail</th>
                        <th>Nascimento</th>
                        <th>Tipo</th>
                        <th class="coluna-acoes">Ações</th>
                    </tr>
                </thead>

                <tbody>

                    {{#each usuarios}}

                    <tr>

                        <td>{{id}}</td>

                        <td>
                            {{nome}}

                            {{#if ehVoce}}
                            <span class="etiqueta etiqueta-voce">você</span>
                            {{/if}}
                        </td>

                        <td>{{email}}</td>

                        <td>{{dataNascimento}}</td>

                        <td>

                            {{#if ehAdmin}}

                            <span class="etiqueta etiqueta-admin">
                                Administrador
                            </span>

                            {{else}}

                            <span class="etiqueta etiqueta-estudante">
                                Estudante
                            </span>

                            {{/if}}

                        </td>

                        <td class="coluna-acoes">

                            {{#unless ehVoce}}

                            <button type="button" class="btn-excluir" data-id="{{id}}" data-nome="{{nome}}">
                                Excluir
                            </button>

                            {{/unless}}

                        </td>

                    </tr>

                    {{else}}

                    <tr>

                        <td colspan="6" class="usuarios-vazio">
                            Nenhum usuário encontrado.
                        </td>

                    </tr>

                    {{/each}}

                </tbody>

            </table>

        </div>

    </div>

</div>


<dialog id="modalNovoUsuario" class="modal-usuario">

    <form id="formNovoUsuario" class="form-usuario" method="dialog">

        <h2>Cadastrar usuário</h2>

        <p id="erroModal" class="erro-modal" hidden></p>

        <div class="campo-usuario">

            <label for="novoNome">Nome completo</label>

            <input type="text" id="novoNome" required>

        </div>

        <div class="campo-usuario">

            <label for="novoEmail">E-mail</label>

            <input type="email" id="novoEmail" required>

        </div>

        <div class="campo-usuario">

            <label for="novaSenha">Senha</label>

            <input type="password" id="novaSenha" required>

        </div>

        <div class="campo-usuario">

            <label for="novaData">Data de nascimento</label>

            <input type="date" id="novaData" required>

        </div>

        <div class="campo-usuario">

            <label for="novoTipo">Tipo de usuário</label>

            <select id="novoTipo">

                <option value="0" selected>Estudante</option>

                <option value="1">Administrador</option>

            </select>

        </div>

        <div class="form-usuario-botoes">

            <button type="button" id="btnCancelar" class="btn-cancelar">
                Cancelar
            </button>

            <button type="submit" class="btn-salvar">
                Cadastrar
            </button>

        </div>

    </form>

</dialog>

<script src="/js/scriptGerenciarUsuarios.js"></script>