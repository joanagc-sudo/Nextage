<link rel="stylesheet" href="styleMateriais.css">
<script src="/js/scriptMateriais.js" defer></script>

<br>

<h1>Conteúdos</h1>
<div style="margin: 40px auto; width: 92%;">
    <div class="seletorDisciplina">

        <button type="button" id="btnDisciplina" class="btnDisciplina">
            <span id="disciplinaAtual">Filosofia</span>
            <span id="setaDisciplina">▼</span>
        </button>

        <div id="listaDisciplinas" class="listaDisciplinas"></div>

    </div>
</div>
</div>

<section class="atalhos" data-disciplina="Filosofia">

    <button class="seta">&lt;</button>

    <div class="atalhos1">

        <div class="assuntos">
            <div class="icones">
                <div class="assuntog1" data-materia="Introdução à Filosofia">Introdução à Filosofia
                    <img src="imagens/iconFilosofia.png" alt>
                </div>
                <div class="assuntog2" data-materia="Áreas da Filosofia">Áreas da Filosofia
                    <img src="imagens/iconFilosofia.png" alt>
                </div>
                <div class="assuntog3" data-materia="Ética e Filosofia Política">Ética e Filosofia Política
                    <img src="imagens/iconFilosofia.png" alt>
                </div>
                <div class="assuntog4" data-materia="Epistemologia">Epistemologia
                    <img src="imagens/iconFilosofia.png" alt>
                </div>
                <div class="assuntog5" data-materia="Filosofia Política">Filosofia Política
                    <img src="imagens/iconFilosofia.png" alt>
                </div>
                <div class="assuntog6" data-materia="Filosofia Medieval">Filosofia Medieval
                    <img src="imagens/iconFilosofia.png" alt>
                </div>
                <div class="assuntog7" data-materia="Filosofia Moderna">Filosofia Moderna
                    <img src="imagens/iconFilosofia.png" alt>
                </div>
                <div class="assuntog8" data-materia="Filosofia Contemporânea">Filosofia Contemporânea
                    <img src="imagens/iconFilosofia.png" alt>
                </div>
                <div class="assuntog9"data-materia="Mal e Justiça">Mal e Justiça
                    <img src="imagens/iconFilosofia.png" alt>
                </div>
                <div class="assuntog10" data-materia="Filosofia Alemã">Filosofia Alemã
                    <img src="imagens/iconFilosofia.png" alt>
                </div>
                <div class="assuntog11" data-materia="Psicanálise e Teoria Crítica">Psicanálise e Teoria Crítica
                    <img src="imagens/iconFilosofia.png" alt>
                </div>
                <div class="assuntog12" data-materia="Existencialismo">Existencialismo
                    <img src="imagens/iconFilosofia.png" alt>
                </div>
                <div class="assuntog13" data-materia="Questões Filosóficas da Contemporaneidade">Questões Filosóficas da Contemporaneidade
                    <img src="imagens/iconFilosofia.png" alt>
                </div>
                <div class="assuntog14" data-materia="Obras Filosóficas">Obras Filosóficas
                    <img src="imagens/iconFilosofia.png" alt>
                </div>
            </div>
        </div>

        <button class="seta">&gt;</button>

    </section>

    <section class="atalhos2">

        <div class="Materiais">
            <h2>Materiais</h2>
            <p>Exercite seu cérebro</p>
        </div>

        <div class="fundoQuestoes">

            <div class="resolverQuestoes">

                <div class="botaoCadastro">

                    <div id="modalMateria" class="modalMateria">
                        <div class="conteudoModal">
                            <h1>Selecione a matéria</h1>
                            <p id="nomeArquivo"></p>

                            <select id="selectMateria">

                                <option value>Escolha uma matéria</option>

                                <option value="Introdução à Filosofia">Introdução à Filosofia</option>
                                <option value="Áreas da Filosofia">Áreas da Filosofia</option>
                                <option value="Ética e Filosofia Política">Ética e Filosofia Política</option>
                                <option value="Epistemologia">Epistemologia</option>
                                <option value="Filosofia Política">Filosofia Política</option>
                                <option value="Filosofia Medieval">Filosofia Medieval</option>
                                <option value="Filosofia Moderna">Filosofia Moderna</option>
                                <option value="Quantidade de Movimento">Filosofia Contemporânea</option>
                                <option value="Mal e Justiça">Mal e Justiça</option>
                                <option value="Filosofia Alemã">Filosofia Alemã</option>
                                <option value="Psicanálise e Teoria Crítica">Psicanálise e Teoria Crítica</option>
                                <option value="Existencialismo">Existencialismo</option>
                                <option value="Questões Filosóficas da Contemporaneidade">Questões Filosóficas da Contemporaneidade</option>
                                <option value="Eletrodinâmica">Obras Filosóficas</option>

                            </select>

                            <div class="botoesModal">

                                <button type="button"
                                    id="cancelarMateria">Cancelar</button>
                                <button type="button"
                                    id="salvarMaterial">Salvar</button>

                            </div>
                        </div>
                    </div>

                    <div class="botaoCadastro">

                        <input type="file" id="fileInput" hidden>

                        <button type="button" class="btn"
                            id="btnCadastrar">+</button>

                    </div>

                </div>
                <div class="textoCadastro">

                    <h2>Cadastrar material</h2>

                    <p>Compartilhe seus conhecimentos<br>
                        e ajude outros usuários</p>

                </div>
            </div>

            <div class="divisor"></div>

            <div class="materiaisCadastrados">

                <h2>Materiais Cadastrados</h2>

                <div class="rolagemMateriais">

                    <table class="tabelaMateriais">

                        <thead>

                            <tr>
                                <th>Nome do material</th>
                                <th>Conteúdo</th>
                                <th>Ações</th>
                            </tr>

                        </thead>

                        <tbody id="listaMateriais">
                        </tbody>
                        
                    </table>

                </div>
            </div>
        </div>

    </section>
    <!-- MODAL DE MATERIAIS COMPARTILHADOS -->

<div id="modalMateriaisCompartilhados" class="modalCompartilhados">

    <div class="conteudoModalCompartilhados">

        <button
            type="button"
            id="fecharModalCompartilhados"
            class="fecharModalCompartilhados">
            ×
        </button>

        <h2 id="tituloModalCompartilhados">
            Materiais
        </h2>

        <p class="subtituloModalCompartilhados">
            Materiais compartilhados pelos usuários
        </p>

        <div class="linhaModal"></div>

        <h3>Materiais disponíveis</h3>

        <div id="listaMateriaisCompartilhados">

            <p class="carregandoMateriais">
                Carregando materiais...
            </p>

        </div>

        <div class="rodapeModalCompartilhados">

            <button
                type="button"
                id="fecharModalCompartilhados2">
                Fechar
            </button>

        </div>

    </div>

</div>
