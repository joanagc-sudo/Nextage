<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<link rel="stylesheet" href="styleQuestoes.css">

<h1>Cadastro de questões</h1>

<div class="filtro">
    <form method="post" action="/filtar">
        

        <div class="containerFiltro">

            <form id="filtrarQuestoes">

                <!-- PALAVRA-CHAVE -->
                <div class="campo-filtro">

                    <label for="palavra-chave" class="form-label">
                        Palavra-chave
                    </label>

                    <input class="form-control" type="text" id="palavra-chave"
                        name="palavra-chave"
                        placeholder="Busque por palavra-chave">

                </div>

                <!-- CAMPOS CRIADOS PELO JAVASCRIPT -->
                <div id="containerFiltros"></div>

            </form>

            <!-- QUESTÕES QUE -->
            <div class="campo-filtro questoes-filtro">

                <label for="questoes-que" class="form-label">
                    Questões que:
                </label>
                <div class="btn-group" role="group">

                    <input type="checkbox" class="btn-check" id="btncheck1">
                    <label class="btn btn-outline-custom" for="btncheck1">
                        Não resolvi
                    </label>

                    <input type="checkbox" class="btn-check" id="btncheck2">
                    <label class="btn btn-outline-custom" for="btncheck2">
                        Resolvi
                    </label>

                    <input type="checkbox" class="btn-check" id="btncheck3">
                    <label class="btn btn-outline-custom" for="btncheck3">
                        Acertei
                    </label>

                    <input type="checkbox" class="btn-check" id="btncheck4">
                    <label class="btn btn-outline-custom" for="btncheck4">
                        Errei
                    </label>

                </div>

            </div>

            <button type="submit" class="btn btn-primary" id="filtrar">
                <i class="bi bi-sort-down"></i> FILTRAR
            </button>
        </div>
    </form>
</div>