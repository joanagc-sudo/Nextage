<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<link rel="stylesheet" href="styleCadastroQuestoes.css">

<h1 class="titulo">Cadastro de Questões</h1>

<form method="post" action="/cadastrar" enctype="multipart/form-data"> <!--fazer a rota-->
    
        <div class="filtro containerFiltro" id="filtro">
            
                <!-- CAMPOS CRIADOS PELO JAVASCRIPT -->
                <div id="containerFiltros"></div>

        </div>
        <div class="filtro" id="questao">

            <label>Enunciado</label><br>
            <textarea placeholder="Digite o enunciado..." name="nameEnunciado"></textarea><br>

            <label for="imageInput">Imagem</label><br>
            <input type="file" id="imageInput" accept="image/*" name="nameImagem"><br>

            <label for="alternativa">Alternativas</label><br>
            <label class="letraAlt">A</label>
            <input type="text" id = "A" placeholder = "Digite a alternativa..." name="nameA"><br>

            <label class="letraAlt">B</label>
            <input type="text" id = "B" placeholder = "Digite a alternativa..." name="nameB"><br>

            <label class="letraAlt">C</label>
            <input type="text" id = "C" placeholder = "Digite a alternativa..."name="nameC"><br>

            <label class="letraAlt">D</label>
            <input type="text" id = "D" placeholder = "Digite a alternativa..."name="nameD"><br>

            <label class="letraAlt">E</label>
            <input type="text" id = "E" placeholder = "Digite a alternativa..." name="nameE"><br>
        </div>

        <div class="filtro" id="alternativa">
            <label>Alternativa correta</label><br>
            <select id="selecioneAlt" name="nameAlt">
                
                <option value="" disabled selected>Selecione uma opção...</option>
                <option value="a" name="opA">a</option>
                <option value="b" name="opB">b</option>
                <option value="c" name="opC">c</option>
                <option value="d" name="opD">d</option>
                <option value="e" name="opE">e</option>

            </select>

        </div>
        <button type="submit" class="btn btn-primary" id="cadastrar-questao">
                CADASTRAR
            </button>
    </form>
</div>

<script src="/js/scriptCadastroQuestao.js"></script>