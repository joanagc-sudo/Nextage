<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<link rel="stylesheet" href="styleCadastroQuestoes.css">

<h1 class="titulo">Cadastro de Questões</h1>

<form action="/cadastro-questoes" method="POST" enctype="multipart/form-data">

    <!-- aqui entram os filtros (Vestibular e Conteúdo) -->
    <div id="containerFiltros"></div>

    <label>Enunciado</label>
    <textarea name="enunciado" class="form-control" required></textarea>

    <input name="alt_a" class="form-control" placeholder="Alternativa A">
    <input name="alt_b" class="form-control" placeholder="Alternativa B">
    <input name="alt_c" class="form-control" placeholder="Alternativa C">
    <input name="alt_d" class="form-control" placeholder="Alternativa D">
    <input name="alt_e" class="form-control" placeholder="Alternativa E">

    <select name="correta" class="form-select" required>
        <option value>Selecione...</option>
        <option value="a">A</option>
        <option value="b">B</option>
        <option value="c">C</option>
        <option value="d">D</option>
        <option value="e">E</option>
    </select>

    <input type="file" name="imagem" accept="image/*">

    <button type="submit" class="btn btn-primary">Cadastrar</button>
</form>

<script src="/js/scriptCadastroQuestao.js"></script>